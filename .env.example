# change these and rename to .env before starting the bot

# bot token
TOKEN=""

# general bot settings
CMD_PREFIX="#!"

# local/dumb llm url
LLM_LOCAL_URL="http://localhost:9931/v1/chat/completions"

# llm api auth (legacy, single provider, used if multi is not configured)
LLM_KEY=""
LLM_PROXY_URL="https://ollama.com/v1/chat/completions"

# multi-cloud provider setup:
# comma-separated provider IDs in priority order
# (the earlier on the list, the higher the priority)
CLOUD_PROVIDERS="ollama"

# per-provider settings (one block per provider ID above)
# - providers require a URL and a key
# - MODEL is optional and falls back to a default if available
OLLAMA_URL="https://ollama.com/v1/chat/completions"
OLLAMA_KEY=""

# example of how to add another lower-priority provider
# CLOUD_PROVIDERS="ollama,groq"
# GROQ_URL="https://api.groq.com/openai/v1/chat/completions"
# GROQ_KEY=""
# GROQ_MODEL="qwen3.8-27b"

# owner user id for global admin
OWNER_ID=""
